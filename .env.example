# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated numeric Telegram user IDs that always have access.
# The first ID is the admin: it approves access requests from new users and can use /users and /stats.
ALLOWED_USERS=123456789

# Optional: SQLite database file (defaults to farebot.db in the project root)
# FAREBOT_DB_PATH=farebot.db

# Timezone for weekly digest delivery times. Optional (defaults to the server's zone),
# but required with Docker, where the container has no local timezone. Use your zone's tz database
# name, e.g. Europe/Athens, Africa/Lagos, America/New_York.
# TIMEZONE=Europe/Athens
